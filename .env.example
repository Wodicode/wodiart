# Resend (https://resend.com) — used to email project requests to you
RESEND_API_KEY=re_your_api_key

# Where intake form submissions should be sent
INTAKE_TO_EMAIL=wodiart@gmail.com

# The "from" address Resend sends as. Must be on a domain you've verified with Resend,
# e.g. "Wodiart <intake@wodiart.com>". For local testing before you verify a domain,
# you can use "Wodiart <onboarding@resend.dev>".
INTAKE_FROM_EMAIL="Wodiart <intake@wodiart.com>"
